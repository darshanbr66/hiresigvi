# Local dev: postgresql+psycopg://user:pass@localhost:5432/dbname
# Render Postgres: take the "External Database URL" Render shows you and
# change its scheme from postgres:// (or postgresql://) to
# postgresql+psycopg:// — SQLAlchemy's async psycopg3 driver requires the
# explicit +psycopg suffix; Render's own connection string does not include
# it. See docs/deployment.md.
DATABASE_URL=postgresql+psycopg://ai_recruitment:changeme@localhost:5432/ai_recruitment

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production: set a freshly generated value in the Render dashboard —
# never reuse the local dev value, never commit the real value anywhere.
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# JSON array of allowed origins (pydantic parses this as JSON, not a plain
# comma list). Production: the deployed Vercel domain(s), e.g.
# ["https://sigvitas.vercel.app"]. Never use ["*"] once cookies/auth are
# involved (allow_credentials=True is incompatible with a wildcard origin
# anyway per the CORS spec).
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# The candidate-facing frontend's own origin — used to build assessment
# invitation / campus-drive links that a recruiter shares. Production: the
# same Vercel domain as above.
FRONTEND_BASE_URL=http://localhost:5173

# Resume FILE BYTES storage backend — "local" (disk, dev default) or
# "mongodb_gridfs" (production; see docs/deployment.md § 11). This is
# independent of DATABASE_URL: candidate/application/resume *metadata*
# always lives in Postgres (CLAUDE.md § 2) — only the raw file bytes move.
RESUME_STORAGE_PROVIDER=local

# Local-disk resume storage (backend/uploads/resumes by default). Only
# used when RESUME_STORAGE_PROVIDER=local. PRODUCTION WARNING: Render's
# default web-service filesystem is ephemeral — anything written here is
# lost on every deploy/restart and is not shared across instances. Set
# RESUME_STORAGE_PROVIDER=mongodb_gridfs in production instead (below).
RESUME_STORAGE_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=10
# Optional 10th marks card on the candidate form (PDF/PNG/JPG).
MAX_MARKS_CARD_SIZE_MB=5

# MongoDB — only used for RESUME_STORAGE_PROVIDER=mongodb_gridfs, storing
# resume file bytes via GridFS (bucket "resumes"). Never used for
# candidate/application/organization data, which stays in Postgres.
# Required if RESUME_STORAGE_PROVIDER=mongodb_gridfs; leave both unset for
# local "local"-provider development. Get a connection string from MongoDB
# Atlas (or any MongoDB deployment) — never commit the real value.
MONGODB_URI=
MONGODB_DATABASE=ai_recruitment

# Optional: outbound email over SMTP — for LOCAL DEVELOPMENT (manual interview/selection emails,
# application confirmations, assessment invitations). Without these the app
# runs fully — sends fail with a clear "email not configured" error rather
# than being faked. Put the real SMTP_PASSWORD in your own local .env only;
# never commit it. (For Gmail, use an app password.)
//dbr@sigvitas.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dbr@sigvitas.com
SMTP_FROM_NAME=AI Recruitment Platform
SMTP_USE_TLS=true

# Production email over HTTPS (https://resend.com). Render's free web services
# block outbound SMTP ports, so set these on the host instead of SMTP_*. When
# both are set, Resend is used in preference to SMTP; leave them empty locally
# to keep using SMTP above. EMAIL_FROM must be on a domain verified in Resend,
# e.g. SIGVITAS <hr@yourdomain.com>. Never commit a real RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: AI-assisted resume screening. Without any of these set,
# screening returns a clear "provider not configured" error rather than a
# fabricated result (a public application is then kept for manual review,
# never screened out). Selection order: Ollama if set, then Anthropic, then
# OpenAI; otherwise Groq (primary) with Gemini as the fallback — see
# GROQ_* and GEMINI_* below (docs/ai-screening.md).

# Free, local, no API key — install Ollama (https://ollama.com), run
# `ollama pull llama3.1` (or another model), then set this to its URL.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Paid, cloud-hosted alternatives — only needed if you don't want to run
# Ollama locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Groq — the primary resume screening provider (https://console.groq.com/keys).
# When GEMINI_API_KEY is also set, a Groq failure (timeout, 429, 5xx, malformed
# reply) gets exactly one Gemini fallback attempt. Backend-only secret: set the
# real value only in your local .env / the host's dashboard; never commit it.
GROQ_API_KEY=
# Must support strict json_schema structured outputs (the GPT-OSS models do).
GROQ_SCREENING_MODEL=openai/gpt-oss-120b
# Leave empty for a non-reasoning model that rejects reasoning parameters.
GROQ_SCREENING_REASONING_EFFORT=low
GROQ_REQUEST_TIMEOUT_SECONDS=30
# Which of groq / gemini is tried first when both keys are set.
AI_SCREENING_PROVIDER=groq

# Sigvi — the public AI assistant on the careers site (POST /api/v1/public/ai/chat).
# Get a free key at https://aistudio.google.com/apikey. Without it the assistant
# answers "temporarily unavailable" — nothing is faked and the rest of the site
# is unaffected. The same key is also the resume screening fallback behind
# Groq (see above). Set the real value only in your local .env / the Render
# dashboard; never commit it.
GEMINI_API_KEY=
# Any Gemini model available to your key; the default has a free tier.
# Used by Sigvi and the internal AI — not by resume screening (below).
GEMINI_MODEL=gemini-3.5-flash-lite
# Resume screening's own Gemini model (docs/ai-screening.md). gemini-2.5-flash
# thinks by default and thinking tokens count against the output limit, so
# screening disables it (budget 0). Leave the budget empty to send no
# thinkingConfig at all (for a model that rejects one).
GEMINI_SCREENING_MODEL=gemini-2.5-flash
GEMINI_SCREENING_THINKING_BUDGET=0
# Seconds to wait for Gemini before telling the visitor to retry.
SIGVI_REQUEST_TIMEOUT_SECONDS=20
# Cap on the length of each reply (cost control).
SIGVI_MAX_OUTPUT_TOKENS=700
# The careers site Sigvi answers about when the visitor's page names none.
SIGVI_ORGANIZATION_SLUG=sigvitas
# Per-instance limits: messages/minute per visitor, and across all visitors.
SIGVI_RATE_LIMIT_PER_MINUTE=8
SIGVI_GLOBAL_RATE_LIMIT_PER_MINUTE=40

# Candidate intake (public careers site / campus drive links). All optional —
# the values below are the defaults.
# Region assumed for a mobile number typed without a "+<country code>"
# prefix (ISO 3166-1 alpha-2). Mobile numbers are stored in E.164 and are
# unique per organization, so "98765 43210" and "+91 98765-43210" are the
# same person. Also read by the candidate-intake migration when it
# normalizes existing numbers.
DEFAULT_PHONE_REGION=IN
# Email one-time-code verification, required before a candidate applies.
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_SENDS_PER_HOUR=5
# How long a verified email may be used to submit an application.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
# Per-client (IP) request budgets per 10-minute window, per instance. The
# per-email limits above (stored in the database) are the authoritative ones.
PUBLIC_OTP_REQUEST_LIMIT_PER_WINDOW=10
PUBLIC_OTP_VERIFY_LIMIT_PER_WINDOW=30
PUBLIC_APPLY_LIMIT_PER_WINDOW=10
