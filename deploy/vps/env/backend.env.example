# Zphirex — PRODUCTION backend settings for the Hostinger VPS.
#
# Copy to /opt/zphirex/app/backend/.env on the server, fill in every
# <...> placeholder, then:
#     sudo chown zphirex:zphirex /opt/zphirex/app/backend/.env
#     sudo chmod 600 /opt/zphirex/app/backend/.env
#
# This file holds NO real values and is safe to commit. The real .env is
# git-ignored and must never be committed, pasted into chat or logged.
# Full reference for every setting: backend/.env.example.
#
# Generate secrets ON THE SERVER, never reuse local development values:
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Runtime mode -----------------------------------------------------------
# "production" is what makes the refresh-token cookie Secure
# (backend/app/api/v1/recruiter/auth.py). Never set DEBUG=true here.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Database (local PostgreSQL 16 on the VPS) ------------------------------
# Format: postgresql+psycopg://<role>:<password>@127.0.0.1:5432/<database>
# The +psycopg suffix is required (async psycopg3 driver). URL-encode any
# special character in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# The role must be the NON-superuser owner created by
# deploy/vps/postgres/init-database.sql — a superuser would bypass the
# tenant-isolation Row-Level Security policies.
DATABASE_URL=postgresql+psycopg://zphirex_app:<url-encoded-password>@127.0.0.1:5432/zphirex

# --- Auth ---------------------------------------------------------------
JWT_SECRET_KEY=<freshly-generated-64-byte-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Browser origins ------------------------------------------------------
# JSON array, exact origins, no trailing slash, never "*".
CORS_ALLOW_ORIGINS=["https://zphirex.com","https://www.zphirex.com"]
# Used to build assessment invitation / campus-drive / program links in
# emails. No trailing slash.
FRONTEND_BASE_URL=https://zphirex.com

# --- File storage: MongoDB Atlas GridFS -------------------------------------
# Uploaded file BYTES (resumes, 10th marks cards, program agreement
# documents) go to GridFS bucket "resumes" (collections resumes.files and
# resumes.chunks). PostgreSQL above keeps all records and file metadata.
RESUME_STORAGE_PROVIDER=mongodb_gridfs
# The PRODUCTION Atlas connection string, for the dedicated production user
# (readWrite on database "zphirex" only — docs/deployment-vps.md § 3).
# Never the local development string or credentials. No database name in the
# path (end with "/?..."): the database is chosen by MONGODB_DATABASE.
# URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<zphirex-prod-user>:<url-encoded-password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority&appName=zphirex
# Dedicated production database. NOT "ai_recruitment" (local development).
MONGODB_DATABASE=zphirex
MAX_RESUME_SIZE_MB=10
MAX_MARKS_CARD_SIZE_MB=5

# --- Email (choose ONE provider) --------------------------------------------
# Option A — Resend over HTTPS (used whenever both values are set).
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Option B — SMTP (port 587 + STARTTLS). Used only when Resend is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Zphirex
SMTP_USE_TLS=true

# --- AI providers (optional — features report "not configured" when unset) ---
GROQ_API_KEY=
GROQ_SCREENING_MODEL=openai/gpt-oss-120b
GROQ_SCREENING_REASONING_EFFORT=low
GROQ_REQUEST_TIMEOUT_SECONDS=30
AI_SCREENING_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SCREENING_MODEL=gemini-2.5-flash
GEMINI_SCREENING_THINKING_BUDGET=0

# --- Candidate intake -------------------------------------------------------
# Also read by a data migration (b4c5d6e7f8a9) — keep it explicit.
DEFAULT_PHONE_REGION=IN
