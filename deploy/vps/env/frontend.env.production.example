# Zphirex — frontend PRODUCTION build setting.
#
# Copy to frontend/.env.production on the machine that runs `npm run build`.
# (frontend/.env.production is git-ignored, like every .env.* file.)
#
# Why a separate file is required: Vite also loads frontend/.env.local during
# `npm run build`, and the local one points at http://localhost:8000. Vite
# gives .env.production priority over .env.local, so this value wins for
# production builds while `npm run dev` keeps using .env.local unchanged.
#
# The variable name is VITE_API_BASE_URL (frontend/src/lib/apiClient.ts).
# Any other name is ignored and the build silently falls back to localhost.
# Everything prefixed VITE_ is public (bundled into the JS) — never put a
# secret here.
VITE_API_BASE_URL=https://api.zphirex.com
